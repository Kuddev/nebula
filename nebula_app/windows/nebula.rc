#define IDI_ICON 0x101

IDI_ICON ICON "nebula.ico"

#define RT_MANIFEST 24
#define APP_MANIFEST 1

APP_MANIFEST RT_MANIFEST nebula.manifest

1 VERSIONINFO
FILEVERSION 1,2,0,0
PRODUCTVERSION 1,2,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Kuddev"
            VALUE "FileDescription", "Nebula Terminal"
            VALUE "FileVersion", "1.2.0"
            VALUE "InternalName", "nebula"
            VALUE "OriginalFilename", "nebula.exe"
            VALUE "ProductName", "Nebula Terminal"
            VALUE "ProductVersion", "1.2.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

