(( $+functions[_nebula_commands] )) ||
_nebula_commands() {
    local commands; commands=(
'ctl:Control the resident Nebula runtime through the versioned local API' \
'migrate:Migrate the configuration file' \
'config:Validate or create the Nebula configuration' \
'notify-test:Test system notification (toast) delivery' \
'setup-ai:Install (or --remove) the Claude Code hooks that feed Nebula'\''s real-time AI turn notifications' \
'ssh:SSH with Nebula shell integration bootstrapped on the remote host, so tab icons / spinner / cwd track the program running over the connection (claude, vim, cargo…). All arguments are forwarded to the system \`ssh\`' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'nebula commands' commands "$@"
}
(( $+functions[_nebula__config_commands] )) ||
_nebula__config_commands() {
    local commands; commands=(
'check:Validate a Lua, TOML, or YAML configuration without opening the GUI' \
'init:Create an annotated Lua configuration template' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'nebula config commands' commands "$@"
}
