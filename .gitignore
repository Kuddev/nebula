target

# Local debug/release build bundles produced by packaging scripts
dist/
trellis/
# `package-release.ps1 -TargetDirectory` builds into its own cargo target dir
# so packaging never invalidates the incremental cache of the main one.
target-pack/

# Local/generated visual assets and scratch files.
docs/ui_mockups/
tmp/
# Window/UI probe captures (probe_*.png) and prototype pages (.tmp-*.html):
# scratch evidence for a single design round, never part of the product.
probe_*.png
.tmp-*.html
# 所有 .tmp-/-tmp_ 前缀的草稿（探针 cfg 目录、截图、stdout 抓取、临时
# 笔记）与备用 cargo target 目录：一次性调试产物，永不入库。
.tmp-*
.tmp_*
.target-*/

# Optional local ConPTY runtime bundle; the app falls back when absent.
assets/windows/conhost/

# Internal agent/session artifacts (review drafts, scratch notes — never publish)
.claude/
.tocodex/
tocodex-docs/
.codex/
*.internal.md

# Local commit policy is machine-specific and must never be published.
/.pre-commit-config.yaml

# `docs/` is private by default. Public documentation must be reviewed and
# explicitly added to this file one path at a time; never allowlist another subtree.
# Third-party research (gap analyses, design studies, local checkouts) stays in
# this private tree and must never be allowlisted — tracked files bypass these
# rules until `git rm --cached`.
/docs/**
!/docs/lua-configuration.md
!/docs/math-rendering-test.md
!/docs/runtime-control-api.md
!/docs/runtime-api-v1.schema.json
!/docs/preview-release-checklist.md
# Reviewed public engineering guides, not private product/competitor investigations.
!/docs/project-constraints.md
!/docs/architecture.md
!/docs/architecture-decisions.md
!/docs/engineering-evidence.md
!/docs/internationalization.md
!/docs/skills/
!/docs/skills/nebula-runtime/
!/docs/skills/nebula-runtime/SKILL.md
!/docs/skills/nebula-runtime/agents/
!/docs/skills/nebula-runtime/agents/openai.yaml
!/docs/release-notes/
!/docs/release-notes/**
!/docs/screenshots/
!/docs/screenshots/**
# Belt-and-suspenders: even if a later allowlist opens more of docs/,
# research filenames stay unpublished.
docs/**/*-gap-analysis.md
docs/**/*-study.md
docs/**/*-research.md
docs/**/*-competitor-*.md
docs/**/research/
docs/**/reference-projects/
docs/**/external-probes/

# Local interactive demos belong under the private docs tree.
/*.html
/*.htm
/docs/**/*.html
/docs/**/*.htm
*-prototype.html
*_prototype.html
*-mockup.html
*_mockup.html
*-prototype.htm
*_prototype.htm
*-mockup.htm
*_mockup.htm
/prototypes/
/TASKS.md

# Reserved local-only work areas; maintained tests and third_party/ stay visible.
/research/
/reference-projects/
/external-probes/
/scratch/
/tmp-*
/tmp_*

# Python-generated caches are not test sources or contract fixtures.
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / credentials / environment — must never be committed
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*.keystore
id_rsa*
*.credentials
secrets.*
*_secret*
*.token

# Editor / IDE local settings
.vscode/
.idea/
*.swp
*.swo
*~

# OS-generated junk
.DS_Store
Thumbs.db
desktop.ini

# Build/debug scratch: parked-exe copies (Windows locked-file workaround),
# logs, crash dumps, profiling output
*.locked
*.log
*.tmp
*.orig
*.rej
*.stackdump
*.pdb.old

# Scratch notes and locally downloaded font archives
body.txt
JetBrainsMono-*.zip

# Local scratch checkouts, prototypes, and one-off repro scripts
.build-*/
target-aligned/
target-fix/
_nebula-front-stage/
message-queue-prototype.html
package.json
package-lock.json
node_modules/
scripts/drawer_repro.ps1
scripts/ghost_repro/
scripts/icon-build/
scripts/render_shell_icon.html

# 探针实例跑的是 debug 产物的副本（见 scripts/launch_probe_instance.ps1）：
# 直接运行构建产物会让下一次 cargo build 以一个含义不明的 mingw 链接错误告终。
.probe/
.run/

# 调试取证与旁路产物：PTY 录制（NEBULA_PTY_RECORD）、工具链输出目录、
# 参考用的外部项目工作拷贝。都不是 Nebula 源码，永不入库。
*.recording
output/
impeccable/

# Windows 下 shell 重定向事故的常见落地物：bash 里写 `2>nul` 会真的建出
# 名为 nul 的文件，`>false` 同理；PowerShell 在 HOME 未展开时把模块缓存
# 写进 cwd。见到就删，这里兜底防止误提交。
/nul
/false
/Microsoft/


# git filter-branch scratch directory
.git-rewrite/

# Claude packaging/probe scratch (this branch)
dist-pack-*/
# 每次 A/B 对照都会开一个新的探针目录（.probe-pack、.probe-layout-daily、
# .probe-tabmenu…），逐个补规则永远漏，所以整族忽略。
.probe-*/

# 隔离启动与运行取证的整族产物。`.run/` 只挡住了目录本身，而实际落地的是
# `.run-release/`、`.run-release-cfg/`、`.run-check.out`、`.run-release-shot.png`
# 这类带后缀的兄弟；隔离实例每次换一个日期/轮次后缀（NEBULA_CONFIG_DIR 全隔离，
# 见 nebula-cursor-and-testing 的做法）。都是一次调试轮次的证据，永不入库。
.run-*
.isolated-*/

# 一次性 DOM/标签计数校验脚本（数 HTML 原型里的标签配对），随原型一起废弃。
.chk*.js

# 截图取证：`probe_*.png` 之外还有 `.dock-probe.png` 这类点号前缀的命名。
*-probe.png

# 本地打包出的可分发目录与预览包（内含 nebula.exe 与 zip）：构建产物，
# 发布走 scripts/package-release.ps1，不从工作区入库。
NebulaTerminal-*/
*-preview-package/
